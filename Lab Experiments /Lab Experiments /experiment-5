from nltk.stem import PorterStemmer

stemmer = PorterStemmer()

words = [
    "playing",
    "played",
    "plays",
    "studies",
    "running".
]

print("Register Number: 192324299")
print("\nPorter Stemmer Algorithm")
print("-" * 35)

for word in words:
    stem = stemmer.stem(word)
    print(word, "->", stem)
