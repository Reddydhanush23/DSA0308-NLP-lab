def plural_fsm(noun):
    state = 0

    if noun.endswith(("s", "sh", "ch", "x", "z")):
        state = 1
        plural = noun + "es"
    elif noun.endswith("y") and len(noun) > 1 and noun[-2] not in "aeiou":
        state = 2
        plural = noun[:-1] + "ies"
    else:
        state = 3
        plural = noun + "s"
    return plural

nouns = ["cat", "bus", "box", "baby", "city", "dish", "book"]

print("Register Number: 192324299")
print("\nFinite-State Machine for Plural Formation")
print("-" * 45)

for noun in nouns:
    print(noun, "->", plural_fsm(noun))
