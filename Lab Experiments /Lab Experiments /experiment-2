def finite_automaton(string):
    state = 0

    for char in string:
        if state == 0:
            if char == 'a':
                state = 1
            else:
                state = 0

        elif state == 1:
            if char == 'a':
                state = 1
            elif char == 'b':
                state = 2
            else:
                state = 0

        elif state == 2:
            if char == 'a':
                state = 1
            else:
                state = 0

    if state == 2:
        return "Accepted: String ends with 'ab'"
    else:
        return "Rejected: String does not end with 'ab'"

test_strings = ["ab", "aab", "abab", "aba", "abb", "hello"]

for s in test_strings:
    print(s, "->", finite_automaton(s))
